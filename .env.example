# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/linksaver?retryWrites=true&w=majority

# Authentication Secrets (Generate secure random 64-char strings)
JWT_SECRET=your_jwt_secret_key_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_key_here

# Master Admin Account (Never commit real credentials to Git)
MASTER_ADMIN_EMAIL=master@example.com
MASTER_ADMIN_PASSWORD=your_super_secure_random_password_here
MASTER_ADMIN_NAME=Master Admin
